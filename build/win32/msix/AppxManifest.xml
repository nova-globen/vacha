<?xml version="1.0" encoding="utf-8"?>
<!--
	Vacha's Microsoft Store (MSIX) package. scripts\package-msix.ps1 fills the
	@@...@@ values; the identity comes from Partner Center (Product identity)
	and the Store re-signs the package, so no certificate of our own is needed.

	ONE Application only. The Store rejects an extra Application with
	AppListEntry="none" as a "headless app" unless the account has the
	HeadlessAppBypass waiver, so the extensions point at other executables in
	the package instead:
	  file types     vacha_open.exe, the forwarder shim: a warm open is a pipe
	                 write, as with the site installer
	  startup task   vacha_resident.exe, a copy of the shim that starts Vacha
	                 with start-hidden (resident mode); a startup task cannot
	                 pass arguments
	  vacha          execution alias for Vacha.exe
	Settings stay in the package's redirected AppData, apart from the site
	installer's, by design.
-->
<Package
	xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
	xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
	xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
	xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
	xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
	IgnorableNamespaces="uap uap3 desktop rescap">

	<Identity
		Name="@@IdentityName@@"
		Publisher="@@Publisher@@"
		Version="@@Version@@"
		ProcessorArchitecture="@@Arch@@" />

	<Properties>
		<DisplayName>Vacha</DisplayName>
		<PublisherDisplayName>@@PublisherDisplayName@@</PublisherDisplayName>
		<Logo>Assets\StoreLogo.png</Logo>
		<Description>A fast text and code editor: as fast as Notepad, as convenient as VS Code.</Description>
	</Properties>

	<Resources>
		<Resource Language="en-us" />
	</Resources>

	<Dependencies>
		<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
	</Dependencies>

	<Capabilities>
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>

	<Applications>
		<Application Id="Vacha" Executable="Vacha.exe" EntryPoint="Windows.FullTrustApplication">
			<uap:VisualElements
				DisplayName="Vacha"
				Description="A fast text and code editor"
				BackgroundColor="transparent"
				Square150x150Logo="Assets\Square150x150Logo.png"
				Square44x44Logo="Assets\Square44x44Logo.png" />
			<Extensions>
				<uap3:Extension Category="windows.appExecutionAlias" Executable="Vacha.exe" EntryPoint="Windows.FullTrustApplication">
					<uap3:AppExecutionAlias>
						<desktop:ExecutionAlias Alias="vacha.exe" />
					</uap3:AppExecutionAlias>
				</uap3:Extension>
				<uap:Extension Category="windows.fileTypeAssociation" Executable="vacha_open.exe" EntryPoint="Windows.FullTrustApplication">
					<uap:FileTypeAssociation Name="text">
						<uap:DisplayName>Text file</uap:DisplayName>
						<uap:SupportedFileTypes>
							<uap:FileType>.txt</uap:FileType>
							<uap:FileType>.text</uap:FileType>
							<uap:FileType>.log</uap:FileType>
							<uap:FileType>.csv</uap:FileType>
							<uap:FileType>.tsv</uap:FileType>
						</uap:SupportedFileTypes>
					</uap:FileTypeAssociation>
				</uap:Extension>
				<uap:Extension Category="windows.fileTypeAssociation" Executable="vacha_open.exe" EntryPoint="Windows.FullTrustApplication">
					<uap:FileTypeAssociation Name="config">
						<uap:DisplayName>Configuration file</uap:DisplayName>
						<uap:SupportedFileTypes>
							<uap:FileType>.ini</uap:FileType>
							<uap:FileType>.cfg</uap:FileType>
							<uap:FileType>.conf</uap:FileType>
							<uap:FileType>.env</uap:FileType>
							<uap:FileType>.properties</uap:FileType>
							<uap:FileType>.toml</uap:FileType>
							<uap:FileType>.yml</uap:FileType>
							<uap:FileType>.yaml</uap:FileType>
							<uap:FileType>.json</uap:FileType>
							<uap:FileType>.jsonc</uap:FileType>
							<uap:FileType>.xml</uap:FileType>
						</uap:SupportedFileTypes>
					</uap:FileTypeAssociation>
				</uap:Extension>
				<uap:Extension Category="windows.fileTypeAssociation" Executable="vacha_open.exe" EntryPoint="Windows.FullTrustApplication">
					<uap:FileTypeAssociation Name="markdown">
						<uap:DisplayName>Markdown document</uap:DisplayName>
						<uap:SupportedFileTypes>
							<uap:FileType>.md</uap:FileType>
							<uap:FileType>.markdown</uap:FileType>
						</uap:SupportedFileTypes>
					</uap:FileTypeAssociation>
				</uap:Extension>
				<desktop:Extension Category="windows.startupTask" Executable="vacha_resident.exe" EntryPoint="Windows.FullTrustApplication">
					<desktop:StartupTask TaskId="VachaResident" Enabled="true" DisplayName="Vacha" />
				</desktop:Extension>
			</Extensions>
		</Application>
	</Applications>
</Package>
